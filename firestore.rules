rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && request.resource.data.role == 'user');
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
      match /cart/{cartId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /favourites/{favouriteId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /addresses/{addressId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /reviews/{reviewId} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    match /Products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number;
      allow update, delete: if isAdmin();
    }
    match /sales/{saleId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /banners/{bannerId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /promoCodes/{promoCodeId} { allow get: if signedIn(); allow list: if isAdmin(); allow create, update, delete: if isAdmin(); }
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /deliveryFees/{governorate} { allow read, create, update, delete: if isAdmin(); }

    // Admin-only configuration and audit records for the command center.
    match /automationRules/{ruleId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
